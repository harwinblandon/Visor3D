POSTGRES_USER=visor3d
POSTGRES_PASSWORD=visor3d
POSTGRES_DB=visor3d
POSTGRES_PORT=5432

DATABASE_URL=postgres://visor3d:visor3d@localhost:5432/visor3d

BACKEND_PORT=4000

# Clave para poder subir/reemplazar modelos (el visor y las mediciones quedan libres para todos)
ADMIN_PASSWORD=cambia-esta-clave

# Almacenamiento persistente (Cloudflare R2, API compatible con S3) -- opcional. Sin esto,
# los archivos subidos solo viven en el disco local (bien para desarrollo; en una plataforma
# de disco efímero como Render free tier, se pierden en cada redeploy/reinicio).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
